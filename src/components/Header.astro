---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Logo from "@/assets/logo-blanco.svg";

const links = [
  { href: "/", label: "Home" },
  { href: "/sobre-mi", label: "Sobre mi" },
  { href: "/portafolio", label: "Portafolio" },
  { href: "/contacto", label: "Contacto" },
];

const currentPath = Astro.url.pathname;
---

<div id="loading-wrap" aria-hidden="true">
  <div class="loading-effect"></div>
</div>

<header
  id="site-header"
  class="absolute inset-x-0 top-0 z-40"
  data-astro-transition-persist
>
  <div
    id="header-top"
    class="bg-ink"
  >
    <div class="container-page">
      <div class="flex h-20 items-center justify-between">
        <a
          href="/"
          class="logo flex shrink-0 items-center"
          aria-label="Leonardo Chigne - Inicio"
        >
          <Image
            src={Logo}
            alt="Leonardo Chigne"
            width={80}
            height={80}
            loading="eager"
            class="LogoLeo h-12 w-12 transition-[height,width] duration-300 ease-out md:h-16 md:w-16"
          />
        </a>

        <nav aria-label="Principal" class="hidden md:block">
          <ul class="flex items-center gap-9">
            {
              links.map((l) => {
                const active =
                  l.href === "/"
                    ? currentPath === "/"
                    : currentPath.startsWith(l.href);
                return (
                  <li>
                    <a
                      href={l.href}
                      aria-current={active ? "page" : undefined}
                      data-active={active}
                      class="nav-link relative inline-flex h-full items-center text-[13px] font-bold uppercase tracking-[0.4px] text-paper transition-all duration-300 group-[.is-sticky]:text-[12px]"
                    >
                      {l.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <button
          type="button"
          id="menu-toggle"
          class="grid h-11 w-11 place-items-center rounded text-paper hover:bg-white/10 md:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="side-menu"
        >
          <Icon name="mdi:menu" class="size-7" />
        </button>
      </div>
    </div>
  </div>
</header>

<div class="h-20 bg-ink" aria-hidden="true"></div>

<aside
  id="side-menu"
  class="fixed inset-y-0 right-0 z-50 w-80 max-w-[85vw] translate-x-full bg-ink text-paper transition-transform duration-300 ease-in-out"
  aria-label="Menú lateral"
  aria-hidden="true"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-end px-6 py-5">
      <button
        type="button"
        id="menu-close"
        class="grid size-11 place-items-center rounded text-paper hover:bg-white/10"
        aria-label="Cerrar menú"
      >
        <Icon name="mdi:close" class="size-7" />
      </button>
    </div>
    <nav class="flex-1 px-6" aria-label="Navegación principal">
      <ul class="flex flex-col gap-1">
        {
          links.map((l) => {
            const active =
              l.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(l.href);
            return (
              <li>
                <a
                  href={l.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "block rounded-md px-4 py-3 text-base font-semibold uppercase tracking-[0.2em] text-paper/80 transition-colors hover:bg-white/5 hover:text-paper",
                    active && "bg-white/5 text-paper",
                  ]}
                >
                  {l.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div class="border-t border-white/10 px-6 py-6 text-xs text-paper/50">
      <p>leochigne.art</p>
    </div>
  </div>
</aside>

<div
  id="menu-backdrop"
  class="fixed inset-0 z-40 hidden bg-ink/70 backdrop-blur-sm transition-opacity"
  aria-hidden="true"
></div>

<button
  type="button"
  id="back-to-top-fab"
  aria-label="Volver arriba"
  class="fixed bottom-6 right-6 z-30 grid size-11 place-items-center rounded-md bg-paper text-ink opacity-0 shadow-md transition-all duration-300 hover:bg-mute print:hidden"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="m18 15-6-6-6 6" />
  </svg>
</button>

<script>
  const setup = () => {
    const headerTop = document.getElementById("header-top");
    const toggle = document.getElementById("menu-toggle");
    const close = document.getElementById("menu-close");
    const sideMenu = document.getElementById("side-menu");
    const backdrop = document.getElementById("menu-backdrop");
    const navLinks = sideMenu?.querySelectorAll<HTMLAnchorElement>("a");
    const logo = document.querySelector<HTMLImageElement>(".logo img");

    const openMenu = () => {
      if (!sideMenu || !backdrop || !toggle) return;
      sideMenu.classList.remove("translate-x-full");
      sideMenu.classList.add("translate-x-0");
      sideMenu.setAttribute("aria-hidden", "false");
      backdrop.classList.remove("hidden");
      backdrop.classList.add("block");
      toggle.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      if (!sideMenu || !backdrop || !toggle) return;
      sideMenu.classList.add("translate-x-full");
      sideMenu.classList.remove("translate-x-0");
      sideMenu.setAttribute("aria-hidden", "true");
      backdrop.classList.add("hidden");
      backdrop.classList.remove("block");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    };

    toggle?.addEventListener("click", openMenu);
    close?.addEventListener("click", closeMenu);
    backdrop?.addEventListener("click", closeMenu);
    navLinks?.forEach((a) => a.addEventListener("click", closeMenu));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrolled = window.scrollY > 60;
          if (headerTop) {
            headerTop.classList.toggle("is-sticky", scrolled);
          }
          if (logo) {
            logo.style.height = scrolled ? "32px" : "";
            logo.style.width = scrolled ? "32px" : "";
          }
          ticking = false;
        });
        ticking = true;
      }
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    const fab = document.getElementById("back-to-top-fab");
    if (fab) {
      const toggleFab = () => {
        const visible = window.scrollY > 400;
        fab.classList.toggle("opacity-0", !visible);
        fab.classList.toggle("pointer-events-none", !visible);
        fab.classList.toggle("translate-y-3", !visible);
      };
      fab.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: "smooth" })
      );
      window.addEventListener("scroll", toggleFab, { passive: true });
      toggleFab();
    }

    const loading = document.getElementById("loading-wrap");
    if (loading) {
      window.addEventListener(
        "load",
        () => {
          loading.style.transition = "opacity 600ms ease";
          loading.style.opacity = "0";
          setTimeout(() => loading.remove(), 800);
        },
        { once: true }
      );
    }
  };

  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .nav-link {
    height: 100%;
    line-height: 1;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--color-paper);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-link:hover::after,
  .nav-link[data-active="true"]::after {
    transform: scaleX(0.7);
  }
  #header-top {
    transition:
      padding 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  #header-top.is-sticky {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
    background-color: var(--color-ink);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  }
  #header-top.is-sticky .container-page > div {
    height: 48px;
  }
  #site-header:has(#header-top.is-sticky) + [aria-hidden="true"] {
    display: none;
  }
  .logo img {
    transition:
      height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #back-to-top-fab {
    transform-origin: bottom right;
  }
  :focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
    }
  }
</style>
