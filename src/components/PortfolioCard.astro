---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  item: CollectionEntry<"portfolio">;
  index?: number;
  priority?: boolean;
}

const { item, index = 0, priority = false } = Astro.props;
const { data, id } = item;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true }
);

const coverKey = data.cover.replace("@/", "/src/");
const coverAsset = allImages[coverKey]?.default;

const galleryPaths = data.gallery?.map((p) => p.replace("@/", "/src/")) ?? [];
const galleryAssets = galleryPaths
  .map((p) => allImages[p]?.default)
  .filter((a): a is ImageMetadata => Boolean(a));

const allAssets = coverAsset
  ? [coverAsset, ...galleryAssets.filter((a) => a.src !== coverAsset.src)]
  : galleryAssets;

const optimized = await Promise.all(
  allAssets.map((a) =>
    getImage({ src: a, width: 1600, format: "webp", quality: 82 })
  )
);

const optimizedCover = await getImage({
  src: coverAsset ?? allAssets[0],
  width: 900,
  format: "webp",
  quality: 80,
});

const firstSrc = optimized[0]?.src ?? "#";

const categoryLabels: Record<string, string> = {
  branding: "Branding",
  editorial: "Editorial",
  graphic: "Diseño Gráfico",
  motion: "Motion Graphics",
  video: "Video Editing",
};
---

<article data-cat={data.category} data-gallery-id={id} class="group">
  <a
    href={firstSrc}
    data-lightbox
    data-gallery-id={id}
    data-gallery-title={data.title}
    aria-label={`Ver ${data.title}`}
    class="block overflow-hidden rounded-xl bg-mist focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2"
  >
    {
      coverAsset && (
        <img
          src={optimizedCover.src}
          width={optimizedCover.attributes.width ?? 900}
          height={optimizedCover.attributes.height ?? 675}
          alt={data.title}
          loading={priority && index < 3 ? "eager" : "lazy"}
          fetchpriority={priority && index < 3 ? "high" : "auto"}
          decoding="async"
          class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      )
    }
  </a>
  <div class="mt-4 text-center">
    <h3 class="text-base font-semibold tracking-tight md:text-lg">
      {data.title}
    </h3>
    <p class="mt-1 text-xs uppercase tracking-wider text-ink/50">
      {categoryLabels[data.category] ?? data.category}
    </p>
  </div>
</article>
