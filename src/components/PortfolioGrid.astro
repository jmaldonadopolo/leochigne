---
import type { CollectionEntry } from "astro:content";
import PortfolioCard from "@/components/PortfolioCard.astro";

interface Props {
  items: CollectionEntry<"portfolio">[];
  priority?: boolean;
}

const { items, priority = false } = Astro.props;
---

<div class="portfolio-grid mx-[-15px] mb-[-30px]">
  <div class="flex flex-wrap">
    {
      items.map((item, i) => (
        <PortfolioCard item={item} index={i} priority={priority} />
      ))
    }
  </div>
</div>
