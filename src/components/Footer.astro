---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Logo from "@/assets/logo-blanco.svg";

const socials = [
  { href: "https://www.upwork.com/freelancers/~01b991c824881741b8", label: "Perfil UpWork", icon: "simple-icons:upwork" },
  { href: "https://behance.com/leochigne", label: "Perfil Behance", icon: "simple-icons:behance" },
  { href: "https://www.linkedin.com/in/leonardo-chigne", label: "LinkedIn", icon: "simple-icons:linkedin" },
  { href: "https://facebook.com/leochigne", label: "Facebook", icon: "simple-icons:facebook" },
  { href: "https://twitter.com/leochigne", label: "Twitter", icon: "simple-icons:twitter" },
  { href: "https://api.whatsapp.com/send?phone=%2B34747412444", label: "WhatsApp", icon: "simple-icons:whatsapp" },
];

const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper">
    <div class="pt-20 pb-12 md:pt-[100px]">
    <div class="container-page">
      <div class="grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <a
            href="/"
            class="inline-flex"
            aria-label="Leonardo Chigne - Inicio"
          >
            <Image
              src={Logo}
              alt="Leonardo Chigne"
              height={80}
              loading="lazy"
              class="h-16 w-16"
            />
          </a>
          <p class="mt-6 max-w-sm text-[15px] leading-relaxed text-paper/70">
            Soy Leonardo Chigne Video &amp; Marketing Creative
            <br />
            con +10 años de experiencia en paid media
            <br />
            y contenido digital.
          </p>
        </div>

        <div class="md:col-span-3">
          <h2 class="text-[18px] font-medium text-paper">Contacto</h2>
          <ul class="mt-6 space-y-3 text-[15px]">
            <li class="leading-[30px]">
              <span class="font-medium text-[#b0b0b0]">Teléfono:</span>
              <a
                href="tel:+34747412444"
                class="ml-1 font-light text-paper transition-colors hover:text-accent"
              >+34747412444</a>
            </li>
            <li class="leading-[30px]">
              <span class="font-medium text-[#b0b0b0]">Email:</span>
              <a
                href="mailto:leochigne@gmail.com"
                class="ml-1 font-light text-paper transition-colors hover:text-accent"
              >leochigne@gmail.com</a>
            </li>
          </ul>
        </div>

        <div class="md:col-span-4">
          <h2 class="text-[18px] font-medium text-paper">Redes Sociales</h2>
          <ul class="mt-6 grid grid-cols-1 gap-x-6 gap-y-3 text-[15px] sm:grid-cols-2">
            {
              socials.map((s) => (
                <li class="leading-[30px]">
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-2.5 text-paper/80 transition-colors hover:text-paper"
                  >
                    <Icon
                      name={s.icon}
                      class="size-[15px] text-paper/60 transition-colors group-hover:text-paper"
                      aria-hidden="true"
                    />
                    <span class="font-light">{s.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/5 py-4">
    <div class="container-page">
      <p class="text-center text-[13px] font-light text-[#b0b0b0]">
        <a href="/" class="text-paper/70 transition-colors hover:text-paper"
          >leochigne.art</a
        >. Todos los derechos reservados.
        <span class="ml-1 text-[#505050]">© {year}</span>
      </p>
    </div>
  </div>
</footer>
