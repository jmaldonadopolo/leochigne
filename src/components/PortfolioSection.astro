---
import { getCollection } from "astro:content";
import PortfolioFilter from "@/components/PortfolioFilter.astro";
import PortfolioGrid from "@/components/PortfolioGrid.astro";
import PortfolioLightbox from "@/components/PortfolioLightbox.astro";

interface Props {
  showAll?: boolean;
  heading?: string;
  description?: string;
}

const {
  showAll = false,
  heading = "Portafolio",
  description = "Una selección de proyectos de branding, motion graphics, video y diseño gráfico.",
} = Astro.props;

const allItems = (await getCollection("portfolio")).sort((a, b) =>
  a.id.localeCompare(b.id)
);
---

<section
  id="portafolio"
  aria-labelledby="portafolio-title"
  class="bg-paper scroll-mt-24 pt-[80px] pb-[80px] md:pt-[120px] md:pb-[120px]"
>
  <div class="container-page">
    <header class="mx-auto mb-12 max-w-2xl text-center md:mb-14">
      <h2
        id="portafolio-title"
        class="mb-3 text-[30px] font-semibold text-ink md:text-[36px]"
      >
        {heading}
      </h2>
      <p class="text-[15px] leading-relaxed text-ink/60">
        {description}
      </p>
    </header>
    <PortfolioFilter />
    <PortfolioGrid items={allItems} priority />
    {
      !showAll && (
        <div class="mt-12 text-center">
          <a href="/portafolio" class="btn btn-theme">
            Ver más proyectos
          </a>
        </div>
      )
    }
  </div>
</section>

<PortfolioLightbox />
