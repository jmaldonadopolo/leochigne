---
import { Image } from "astro:assets";
import LogoUpwork from "@/assets/Upwork_Logo.svg";
import ProfileUpWork from "@/assets/ProfileUpWork.png";
---

<section aria-labelledby="upwork-title" class="section">
  <div class="container-page">
    <div class="flex flex-col items-center text-center">
      <Image
        src={LogoUpwork}
        alt="Upwork"
        height={28}
        loading="lazy"
        class="h-6 w-auto opacity-90"
      />
      <h2 id="upwork-title" class="sr-only">Perfil de Upwork</h2>
      <a
        href="https://www.upwork.com/freelancers/~01b991c824881741b8"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 block max-w-md transition-opacity hover:opacity-90"
        aria-label="Ver perfil de Leonardo Chigne en Upwork"
      >
        <Image
          src={ProfileUpWork}
          alt="Perfil de Leonardo Chigne en Upwork"
          width={520}
          densities={[1, 2]}
          loading="lazy"
          class="w-full rounded-xl shadow-sm"
        />
      </a>
    </div>
  </div>
</section>
