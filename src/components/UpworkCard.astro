---
import { Image, getImage } from "astro:assets";
import LogoUpwork from "@/assets/Upwork_Logo.svg";
import ProfileUpWork from "@/assets/ProfileUpWork-real.png";

const profileUrl = (
  await getImage({ src: ProfileUpWork, width: 1100, format: "webp", quality: 88 })
).src;
---

<section class="bg-paper pb-20 md:pb-[120px]">
  <div class="container-page">
    <div class="text-center">
      <Image
        src={LogoUpwork}
        alt="Upwork"
        height={30}
        loading="lazy"
        class="mx-auto mb-8 h-7 w-auto md:mb-10"
      />
      <a
        href="https://www.upwork.com/freelancers/~01b991c824881741b8"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-lg transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2"
        aria-label="Ver perfil de Leonardo Chigne en Upwork"
      >
        <img
          src={profileUrl}
          alt="Perfil de Leonardo Chigne en Upwork: 100% Job Success, Top Rated Plus, 109 trabajos, 3,402 horas"
          loading="lazy"
          decoding="async"
          class="mx-auto w-full max-w-3xl rounded-lg shadow-sm"
        />
      </a>
    </div>
  </div>
</section>
