---
import { Icon } from "astro-icon/components";

interface Gallery {
  id: string;
  title: string;
  srcs: string[];
  alts: string[];
}

interface Props {
  galleries: Gallery[];
}

const { galleries } = Astro.props;

const galleriesJson = JSON.stringify(
  galleries.map((g) => ({
    id: g.id,
    title: g.title,
    srcs: g.srcs,
    alts: g.alts,
  }))
);
---

<dialog
  id="lightbox"
  class="m-0 h-screen max-h-screen w-screen max-w-screen bg-transparent p-0 backdrop:bg-ink/90"
  aria-label="Visor de imagen"
>
  <button
    type="button"
    command="close"
    commandfor="lightbox"
    aria-label="Cerrar"
    class="absolute right-4 top-4 z-10 grid size-11 place-items-center rounded-full bg-paper/10 text-paper hover:bg-paper/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-paper"
  >
    <Icon name="mdi:close" class="size-6" aria-hidden="true" />
  </button>

  <button
    type="button"
    data-lb-prev
    aria-label="Imagen anterior"
    class="absolute left-4 top-1/2 z-10 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-paper/10 text-paper hover:bg-paper/20 disabled:opacity-30 focus:outline-none focus-visible:ring-2 focus-visible:ring-paper"
    disabled
  >
    <Icon name="mdi:chevron-left" class="size-7" aria-hidden="true" />
  </button>

  <button
    type="button"
    data-lb-next
    aria-label="Imagen siguiente"
    class="absolute right-4 top-1/2 z-10 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-paper/10 text-paper hover:bg-paper/20 disabled:opacity-30 focus:outline-none focus-visible:ring-2 focus-visible:ring-paper"
    disabled
  >
    <Icon name="mdi:chevron-right" class="size-7" aria-hidden="true" />
  </button>

  <figure class="grid h-full place-items-center px-4 py-16">
    <img
      data-lb-img
      src=""
      alt=""
      class="max-h-[80vh] max-w-full rounded-md object-contain shadow-2xl"
    />
    <figcaption
      data-lb-caption
      class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-ink/70 px-4 py-2 text-xs text-paper"
    ></figcaption>
  </figure>
</dialog>

<script type="application/json" id="lightbox-data" is:inline set:html={galleriesJson} />

<script>
  const setup = () => {
    const dlg = document.getElementById("lightbox") as HTMLDialogElement | null;
    const img = document.querySelector<HTMLImageElement>("[data-lb-img]");
    const caption = document.querySelector<HTMLElement>("[data-lb-caption]");
    const prev = document.querySelector<HTMLButtonElement>("[data-lb-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-lb-next]");
    const dataEl = document.getElementById("lightbox-data");
    if (!dlg || !img || !caption || !prev || !next || !dataEl) return;

    type Gallery = { id: string; title: string; srcs: string[]; alts: string[] };
    const galleries: Record<string, Gallery> = JSON.parse(dataEl.textContent || "{}");

    let current: Gallery | null = null;
    let idx = 0;

    const render = () => {
      if (!current) return;
      img!.src = current.srcs[idx];
      img!.alt = current.alts[idx] ?? current.title;
      caption!.textContent = `${current.title} · ${idx + 1} / ${current.srcs.length}`;
      prev!.disabled = idx === 0;
      next!.disabled = idx === current.srcs.length - 1;
    };

    const open = (galleryId: string, startIdx: number) => {
      current = galleries[galleryId] ?? null;
      if (!current || current.srcs.length === 0) return;
      idx = Math.min(startIdx, current.srcs.length - 1);
      render();
      dlg!.showModal();
    };

    prev.addEventListener("click", () => {
      if (idx > 0) { idx--; render(); }
    });
    next.addEventListener("click", () => {
      if (current && idx < current.srcs.length - 1) { idx++; render(); }
    });
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener("close", () => {
      img!.src = "";
    });
    document.addEventListener("keydown", (e) => {
      if (!dlg.open) return;
      if (e.key === "ArrowLeft") prev.click();
      if (e.key === "ArrowRight") next.click();
    });

    document.querySelectorAll<HTMLAnchorElement>("[data-lightbox]").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const galleryId = a.dataset.galleryId;
        if (!galleryId) return;
        open(galleryId, 0);
      });
    });
  };

  document.addEventListener("astro:page-load", setup);
</script>
