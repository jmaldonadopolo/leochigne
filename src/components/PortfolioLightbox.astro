---
import "photoswipe/style.css";
---

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  let lightboxes: any[] = [];

  const destroyLightboxes = () => {
    lightboxes.forEach((lb) => {
      try {
        lb.destroy();
      } catch (e) {}
    });
    lightboxes = [];
  };

  const initLightbox = () => {
    destroyLightboxes();

    document.querySelectorAll(".pswp-gallery").forEach((gallery) => {
      const thumbImgs = Array.from(
        gallery.querySelectorAll<HTMLImageElement>("a > img")
      ).map((img) => img.src);

      const lightbox = new PhotoSwipeLightbox({
        gallery: gallery as HTMLElement,
        children: "a",
        pswpModule: () => import("photoswipe"),
        bgOpacity: 0.95,
        showHideAnimationType: "fade",
        showAnimationDuration: 300,
        hideAnimationDuration: 300,
        padding: { top: 70, bottom: 120, left: 24, right: 24 },
        arrowPrev: true,
        arrowNext: true,
        counter: true,
        closeOnVerticalDrag: true,
        imageClickAction: "zoom",
        tapAction: "toggle-controls",
        closeTitle: "Cerrar (Esc)",
        arrowPrevTitle: "Imagen anterior",
        arrowNextTitle: "Imagen siguiente",
        zoomTitle: "Zoom",
      });

      if (thumbImgs.length > 1) {
        lightbox.on("uiRegister", () => {
          const pswp = lightbox.pswp as any;
          if (!pswp || !pswp.ui) return;

          pswp.ui.registerElement({
            name: "thumbnailsStrip",
            className: "pswp__thumbnails-strip",
            appendTo: "root",
            onInit: (el: HTMLElement, pswp: any) => {
              const numItems = pswp.getNumItems();
              if (numItems <= 1) {
                el.style.display = "none";
                return;
              }

              const thumbs: HTMLButtonElement[] = [];
              const strip = document.createElement("div");
              strip.className = "pswp__thumbs-track";

              for (let i = 0; i < numItems; i++) {
                const thumb = document.createElement("button");
                thumb.type = "button";
                thumb.className = "pswp__thumb";
                thumb.setAttribute("aria-label", `Ir a imagen ${i + 1}`);
                const img = document.createElement("img");
                if (thumbImgs[i]) {
                  img.src = thumbImgs[i];
                }
                img.alt = "";
                img.loading = "lazy";
                thumb.appendChild(img);
                thumb.addEventListener("click", (e) => {
                  e.stopPropagation();
                  pswp.goTo(i);
                });
                strip.appendChild(thumb);
                thumbs.push(thumb);
              }

              el.appendChild(strip);

              pswp.on("change", () => {
                thumbs.forEach((t, i) => {
                  t.classList.toggle("pswp__thumb--active", i === pswp.currIndex);
                });
                const active = thumbs[pswp.currIndex];
                if (active) {
                  active.scrollIntoView({
                    behavior: "smooth",
                    inline: "center",
                    block: "nearest",
                  });
                }
              });

              if (thumbs[pswp.currIndex]) {
                thumbs[pswp.currIndex].classList.add("pswp__thumb--active");
              }
            },
          });
        });
      }

      lightbox.init();
      lightboxes.push(lightbox);
    });
  };

  document.addEventListener("astro:page-load", initLightbox);
  document.addEventListener("astro:before-swap", destroyLightboxes);
</script>

<style is:global>
  .pswp {
    --pswp-icon-color: #ffffff;
    --pswp-icon-color-secondary: rgba(255, 255, 255, 0.7);
  }

  .pswp__thumbnails-strip {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    max-width: 90%;
    display: flex;
    justify-content: center;
  }

  .pswp__thumbs-track {
    display: flex;
    gap: 8px;
    padding: 8px;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 12px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }

  .pswp__thumbs-track::-webkit-scrollbar {
    display: none;
  }

  .pswp__thumb {
    flex: 0 0 auto;
    width: 56px;
    height: 42px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    background: transparent;
    transition: border-color 0.2s ease, transform 0.2s ease;
    display: block;
  }

  .pswp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .pswp__thumb--active {
    border-color: #ffffff;
    transform: scale(1.1);
  }

  .pswp__thumb:hover:not(.pswp__thumb--active) {
    border-color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 640px) {
    .pswp__thumb {
      width: 44px;
      height: 33px;
    }
    .pswp__thumbs-track {
      gap: 6px;
      padding: 6px;
    }
  }
</style>
