---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  highlight?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  showImage?: boolean;
}

const { title, highlight, image, imageAlt = "", showImage = true } = Astro.props;
---

<section aria-labelledby="hero-title" class="bg-ink text-paper">
  <div class="container-page">
    <div class="flex flex-col items-center gap-10 md:flex-row md:items-center">
      <div class="md:w-7/12">
        <div class="py-[100px] md:pt-[140px] md:pb-[155px]">
          <h1
            id="hero-title"
            class="m-0 text-[36px] leading-[44px] font-medium text-paper md:text-[64px] md:leading-[74px] lg:text-[70px] lg:leading-[80px]"
          >
            {title}
            {highlight && <br />}
            {highlight}
          </h1>
        </div>
      </div>
      {
        showImage && image && (
          <div class="md:w-5/12">
            <Image
              src={image}
              alt={imageAlt}
              width={600}
              densities={[1, 2]}
              loading="eager"
              fetchpriority="high"
              class="w-full"
            />
          </div>
        )
      }
      {
        !showImage && (
          <div class="hidden md:block md:w-5/12" aria-hidden="true" />
        )
      }
    </div>
  </div>
</section>
