---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  highlight?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  showImage?: boolean;
}

const {
  title,
  highlight,
  image,
  imageAlt = "",
  showImage = true,
} = Astro.props;
---

<section
  aria-labelledby="hero-title"
  class="surface-dark relative overflow-hidden"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-60"
    style="background: radial-gradient(circle at 80% 20%, rgba(12,53,158,0.18), transparent 60%);"
  >
  </div>
  <div class="container-page relative py-20 md:py-28 lg:py-32">
    <div class="grid items-center gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h1
          id="hero-title"
          class="text-4xl font-bold leading-[1.05] text-balance md:text-6xl lg:text-7xl"
        >
          {title}
          {
            highlight && (
              <span class="block text-paper/60">{highlight}</span>
            )
          }
        </h1>
        <slot name="actions" />
      </div>
      {
        showImage && image && (
          <div class="md:col-span-5">
            <Image
              src={image}
              alt={imageAlt}
              width={600}
              densities={[1, 2]}
              loading="eager"
              fetchpriority="high"
              class="w-full max-w-md mx-auto"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
