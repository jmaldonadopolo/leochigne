---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import PortfolioSection from "@/components/PortfolioSection.astro";
import Avatar from "@/assets/hero-avatar.png";

const description =
  "Leonardo Chigne, diseñador gráfico y motion designer con +10 años creando contenido para Nasdaq, Unilever, Workiva y más. Branding, motion graphics, video y dirección creativa.";
---

<Layout
  title="Leonardo Chigne - Diseñador Gráfico y Motion Designer"
  description={description}
  image="/og-image.png"
>
  <Hero
    title="Diseño Gráfico."
    highlight="Motion Graphics."
    image={Avatar}
    imageAlt="Leonardo Chigne"
  />
  <PortfolioSection showAll />
</Layout>
