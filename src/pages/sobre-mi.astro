---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import About from "@/components/About.astro";
import SeoBreadcrumb from "@/components/SeoBreadcrumb.astro";

const description =
  "Magíster en Diseño Gráfico por la UDIT (Madrid) y creativo senior con +10 años de experiencia en video, diseño y marketing digital. Mi trabajo combina storytelling, motion graphics y paid media para marcas internacionales.";
---

<Layout
  title="Sobre mí - Leonardo Chigne"
  description={description}
>
  <Hero title="Hola soy" highlight="Leonardo Chigne" showImage={false} />
  <About />
  <SeoBreadcrumb name="Sobre mí" path="/sobre-mi" />
</Layout>
