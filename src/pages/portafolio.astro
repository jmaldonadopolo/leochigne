---
import Layout from "@/layouts/Layout.astro";
import PortfolioSection from "@/components/PortfolioSection.astro";
import SeoBreadcrumb from "@/components/SeoBreadcrumb.astro";

const description =
  "Portafolio de proyectos de branding, motion graphics, video editing y diseño gráfico de Leonardo Chigne. Trabajos para Samsung, Dove, Nasdaq, Unilever y más.";
---

<Layout
  title="Portafolio - Leonardo Chigne"
  description={description}
>
  <PortfolioSection showAll />
  <SeoBreadcrumb name="Portafolio" path="/portafolio" />
</Layout>
